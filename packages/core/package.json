{
  "name": "@silkor/core",
  "version": "0.1.0",
  "description": "silkor 画布内核：场景树、相机、渲染调度、插件生命周期与能力契约",
  "keywords": [
    "canvas",
    "graphics",
    "scene-graph",
    "whiteboard",
    "plugin-system",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  }
}
