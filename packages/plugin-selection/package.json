{
  "name": "@silkor/plugin-selection",
  "version": "0.1.0",
  "description": "silkor 官方选择插件：点选、框选与多选能力",
  "keywords": [
    "canvas",
    "selection",
    "marquee",
    "whiteboard",
    "typescript"
  ],
  "license": "ISC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@silkor/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  }
}
