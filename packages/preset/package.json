{
  "name": "@silkor/preset",
  "version": "0.1.0",
  "description": "silkor 官方插件预设：一键装配全部官方能力插件，官方插件清单的单一事实来源",
  "keywords": [
    "canvas",
    "plugins",
    "preset",
    "whiteboard",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@silkor/core": "workspace:*",
    "@silkor/plugin-clipboard": "workspace:*",
    "@silkor/plugin-command": "workspace:*",
    "@silkor/plugin-exporter": "workspace:*",
    "@silkor/plugin-history": "workspace:*",
    "@silkor/plugin-interaction": "workspace:*",
    "@silkor/plugin-selection": "workspace:*",
    "@silkor/plugin-text-editor": "workspace:*",
    "@silkor/plugin-viewport": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  }
}
